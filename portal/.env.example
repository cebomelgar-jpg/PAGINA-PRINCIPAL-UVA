# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings > API Keys
# Usá la publishable key (o la anon key heredada) en NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Estas dos variables son públicas y se incorporan al bundle en tiempo de build:
# después de cambiarlas en Vercel, hacé un nuevo deploy.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_PUBLISHABLE_O_ANON_KEY

# SOLO para scripts locales. Usá la secret key (o service_role heredada).
# Nunca va al navegador ni lleva el prefijo NEXT_PUBLIC_.
# No es necesaria en el runtime de Vercel.
SUPABASE_SERVICE_ROLE_KEY=TU_SECRET_O_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Administrador inicial (solo para scripts/bootstrap-admin.mjs)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@unviajeastral.com
ADMIN_PASSWORD=CambiarEstaClave123!
ADMIN_FULL_NAME=Administración UVA

# ---------------------------------------------------------------------------
# Datos públicos del portal
# ---------------------------------------------------------------------------
# En producción usá el dominio público exacto, sin barra final.
# Ejemplo: https://portal.unviajeastral.com
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SITE_URL=https://unviajeastral.com
NEXT_PUBLIC_WHATSAPP_NUMBER=5493434151054

# Datos para transferencias. Si se dejan vacíos, el portal pide coordinar
# los datos por WhatsApp al confirmar el pedido.
NEXT_PUBLIC_BANK_ALIAS=
NEXT_PUBLIC_BANK_CBU=
NEXT_PUBLIC_BANK_HOLDER=
